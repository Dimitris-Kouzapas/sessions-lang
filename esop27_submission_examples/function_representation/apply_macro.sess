apply: local u. u?(local w. w?int. w!int).
                u!int
proc apply u. 
    f (local w. w?int. w!int) <- u
    res int = f(5)
    u <- res 

main: local. end
proc main.
    let inc as (proc u. x int <- u
                        u <- x + 1)
    result int = apply(inc)
    out <- result <- "\n"