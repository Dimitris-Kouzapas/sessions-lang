clientProc: local w. w!int. w?bool
proc clientProc w.
    w <- 15
    ok bool <- w
    let msg string as if ok then "passes" else "does not pass"
    out <- "Value 15 " <- msg <- " the threshold\n"

workerProc: init u. u?int | local c. c?int. c!bool
proc workerProc {u} c.
    threshold int <- u
    value int <- c
    c <- value > threshold

main: local. end
proc main.
    conc with
        role c as clientProc w
        role w as workerProc { proc {u}. u <- 10 } c