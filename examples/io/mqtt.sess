main: local.end
proc main.
	let mqttConfig as {
		service:	"io",
		action: 	"mqtt",
		address:	"tcp://broker.hivemq.com:1883",
		client:		"i-am-client-123321",
		topic:		"myFirstTopic",
		qos:		1,
	}

	mqttClient io <- inp[mqttConfig]
	out[mqttClient] <- "a message for the mqtt client"
	msg string <- inp[mqttClient]
	out <- msg <- "\n"
