fib:
	local user. user?int. 
				user!int
proc fib user.
	x int <- user
	if 		x <= 1
	then 	user <- x
	else	conc with
				role p as current
				role f1 as fib p
				role f2 as fib p

			prevprev int <- f1 <- x - 2
			prev int <- f2 <- x - 1
			user <- prevprev + prev

main: local. end
proc main.
	conc with
		role p as current
		role f as fib p

	out <- "Give an integer: "
	input int <- inp

	r int <- (f <- input)
	out <- "fib " <- input <- " = " <- r <- "\n"
