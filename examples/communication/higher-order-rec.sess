send42: init u. u?int | local p. p!int. rec
proc send42{u} p.
	index int <- u
	let processes as
		[
			send42,
			send24,
			send37,
		]
	p <- 42
	rec processes[index]<(index+1)%3> p


send24: init u. u?int | local p. p!int. rec
proc send24{u} p.
	index int <- u
		let processes as
		[
			send42,
			send24,
			send37,
		]
	p <- 24
	rec processes[index]<(index+1)%3> p

send37: init u. u?int | local p. p!int. rec
proc send37{u} p.
	index int <- u
		let processes as
		[
			send42,
			send24,
			send37,
		]
	p <- 37
	rec processes[index]<(index+1)%3> p

recv: local q. q?int. rec
proc recv q.
	x int <- q
	out <- "received: " <- x <- "\n"
	rec recv q

main: local. end
proc main.
	conc with
		role q as send42<0> p
		role p as recv q
