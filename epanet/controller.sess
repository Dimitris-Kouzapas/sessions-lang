split: local u. u?[pump_status]. u![int]. u![int]. u![int]. u![int]
proc split u.
	order [pump_status] <- u
	if 		order == []
	then 	u <- [] <- [] <- [] <- []
	else 	
			mode1 [int], mode2 [int], mode3 [int], modeb [int] = split(order[1:])
			u <- [order[0].pump1] + mode1
			  <- [order[0].pump2] + mode2
			  <- [order[0].pump3] + mode3
			  <- [order[0].booster] + modeb
