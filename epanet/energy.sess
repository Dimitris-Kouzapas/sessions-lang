predictor:
			init i.
				i?[float].
				i?int
		 |	local u.
				u?int.
				u?int.
				u![float].
				rec

proc predictor(energy_price_distribution [float], distribution_size int) u.
	elements int <- u
	hour int <- u
	let index int as hour % distribution_size

	let prices as
		if 		distribution_size - index >= elements
		then 	energy_price_distribution[index:index + elements]
		else 	energy_price_distribution[index:] + energy_price_distribution[:elements - (distribution_size - index)]

	u <- prices
	rec predictor<energy_price_distribution, distribution_size> u
