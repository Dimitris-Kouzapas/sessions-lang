proc predictor(demand_distribution [[float]], distribution_size int) demand_sensor1 demand_sensor2 controller.
	di1 proxies.demand_info <- demand_sensor1
	di2 proxies.demand_info <- demand_sensor2

	elements int <- controller

	let index int as di1.hour % distribution_size

	let d as
		if 		distribution_size - index >= elements
		then 	demand_distribution[index:index + elements]
		else 	demand_distribution[index:] + demand_distribution[:elements - (distribution_size - index)]

	controller <- d

	rec predictor<demand_distribution, distribution_size> demand_sensor1 demand_sensor2 controller

