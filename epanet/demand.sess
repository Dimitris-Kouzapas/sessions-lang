import epanet.proxies

/***********************************************************
 * demand prediction agent
 ***********************************************************/

predictor:	init i.
				i?[[float]].
				i?int
		 |	local sensor1 sensor2 controller.
				sensor1?proxies.demand_info.
				sensor2?proxies.demand_info.
				controller?int.
				controller![[float]].
				rec
